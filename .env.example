# Copy to .env and fill in real values. Never commit .env.
#
# JWT signing key for backend-api (services/backend-api). Required for
# `docker compose up backend-api` — the app fails fast at startup without it
# outside Development. Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Postgres superuser password for the main `campus` database (docker-compose.yml
# `postgres` and `backend-api` services). Required — `docker compose up` fails
# fast without it (#137). Dev default used across this repo's docs: campus_dev.
POSTGRES_PASSWORD=campus_dev

# Password for the additive, least-privilege `campus_app` Postgres role created
# by db/init/03_create_app_role.sh (#137). Optional — defaults to campus_app_dev
# for local dev if unset. This is the least-privilege app-role password used by
# the backend connection string (#137): docker-compose.yml's backend-api
# ConnectionStrings__Campus connects as Username=campus_app;Password=${POSTGRES_APP_PASSWORD}.
# Rotate before any non-dev deploy.
POSTGRES_APP_PASSWORD=campus_app_dev

# Preshared key OpenFGA (services/authz) requires from any caller of its HTTP
# API on the compose network. Only needed if you run the (currently unwired)
# authz service — no backend code consumes OpenFGA today (RBAC is enforced
# in-DB via PermissionService), and docker-compose.yml falls back to a dev
# default when this is unset, so `docker compose up` no longer fails without it.
# Generate one with, e.g.:
#   openssl rand -base64 32
# Clients must send it as `Authorization: Bearer <key>`.
OPENFGA_PRESHARED_KEY=

# AIS-02 (Copyleaks plagiarism check) credentials — read by docker-compose.yml's
# backend-api service (Copyleaks__Email / Copyleaks__ApiKey / Copyleaks__WebhookSecret).
# Optional: leave blank for local dev — CopyleaksClient fails closed (the
# plagiarism-check endpoint returns 503 rather than crashing) when unset.
# Never commit real values.
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_WEBHOOK_SECRET=
