# Copy to .env and fill in real values. Never commit .env.
#
# JWT signing key for backend-api (services/backend-api). Required for
# `docker compose up backend-api` — the app fails fast at startup without it
# outside Development. Generate one with, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

# Postgres superuser password for the main `campus` database (docker-compose.yml
# `postgres` and `backend-api` services). Required — `docker compose up` fails
# fast without it (#137). Dev default used across this repo's docs: campus_dev.
POSTGRES_PASSWORD=campus_dev

# Password for the additive, least-privilege `campus_app` Postgres role created
# by db/init/03_create_app_role.sh (#137). Optional — defaults to campus_app_dev
# for local dev if unset. Rotate before any non-dev deploy. Not currently used
# by backend-api's default connection string (see db/init/03_create_app_role.sh
# for why the cutover is deliberately deferred).
POSTGRES_APP_PASSWORD=campus_app_dev

# Preshared key OpenFGA (services/authz) requires from any caller of its HTTP
# API on the compose network. Required — `docker compose up` fails fast without
# it (#133). Generate one with, e.g.:
#   openssl rand -base64 32
# Clients must send it as `Authorization: Bearer <key>`.
OPENFGA_PRESHARED_KEY=

# AIS-02: Copyleaks (external plagiarism-detection API — campus-backend's
# Services/CopyleaksClient.cs). Optional — left unset, backend-api's
# plagiarism-check endpoint fails closed with a 503 rather than crashing.
# Sign up at https://copyleaks.com to get an Email/ApiKey pair.
# COPYLEAKS_WEBHOOK_SECRET is any string you generate yourself (e.g.
# `openssl rand -base64 32`) — Copyleaks echoes it back on its completion
# callback so WebhooksController can verify the callback is genuinely theirs.
# In local dev, Copyleaks calls back from the public internet, so `backend-api`
# also needs to be reachable via a tunnel (ngrok/Cloudflare Tunnel) for the
# webhook to ever arrive — a bare `localhost`/compose-internal address won't work.
COPYLEAKS_EMAIL=
COPYLEAKS_API_KEY=
COPYLEAKS_WEBHOOK_SECRET=

# AIS-05: Pangram (external AI-content-detection API — campus-backend's
# Services/PangramClient.cs). Optional — left unset, the ai-detection endpoint
# fails closed with a 503 rather than crashing. Sign up at pangram.com for an
# API key. Unlike Copyleaks, this is a synchronous request/response call, so
# no webhook/tunnel setup is needed.
PANGRAM_API_KEY=
